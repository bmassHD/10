{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/citizen-lookup.ts": {
      "includeFiles": "src/data/data.json"
    },
    "api/ai/[action].ts": {
      "includeFiles": "firebase-applet-config.json"
    },
    "api/auth/zalo/[action].ts": {
      "includeFiles": "firebase-applet-config.json"
    },
    "api/auth/qr/[action].ts": {
      "includeFiles": "firebase-applet-config.json"
    },
    "api/hooks/sepay-payment.ts": {
      "includeFiles": "firebase-applet-config.json"
    },
    "api/sepay/[action].ts": {
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "rewrites": [
    {
      "source": "/hooks/sepay-payment",
      "destination": "/api/hooks/sepay-payment"
    },
    {
      "source": "/((?!api/|hooks/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(seoapp\\.jpg|seoapp\\.png|iconapp\\.png)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization"
        }
      ]
    }
  ]
}
